9:I[3332,["947","static/chunks/7fd2370d-604f7b16893c3389.js?dpl=dpl_H9boyQNzn5mWsuBVLkaVb8JjY3WH","823","static/chunks/823-5a4916a3b91045ec.js?dpl=dpl_H9boyQNzn5mWsuBVLkaVb8JjY3WH","478","static/chunks/478-1c79ca78c34c8f1a.js?dpl=dpl_H9boyQNzn5mWsuBVLkaVb8JjY3WH","528","static/chunks/528-ce74522fe7daa82e.js?dpl=dpl_H9boyQNzn5mWsuBVLkaVb8JjY3WH","376","static/chunks/376-6dea7a78410b6ad0.js?dpl=dpl_H9boyQNzn5mWsuBVLkaVb8JjY3WH","340","static/chunks/340-816a9923a87d460c.js?dpl=dpl_H9boyQNzn5mWsuBVLkaVb8JjY3WH","751","static/chunks/751-4ba22589dbd220d5.js?dpl=dpl_H9boyQNzn5mWsuBVLkaVb8JjY3WH","317","static/chunks/317-ed7330059b349994.js?dpl=dpl_H9boyQNzn5mWsuBVLkaVb8JjY3WH","42","static/chunks/app/%5Bslug%5D/page-4d4f4bb6e21ffe82.js?dpl=dpl_H9boyQNzn5mWsuBVLkaVb8JjY3WH"],"TierOneSection"]
2:[["$","$L9","0",{"data":{"__typename":"ComponentSectionsTierOne","id":"21","title":"Indian Paralympic Champions & Purple Sports","description":"Celebrating India’s historic 29-medal Paris 2024 & Tokyo 2020 Paralympic Hall of Fame and bringing live adaptive sports championships (Wheelchair Basketball, Boccia, Blind Football, Para-Table Tennis & Sitting Volleyball) to Zone 04 in Vadodara.","button":{"id":"1384","title":"Register for Zone 04 Para-Sports · ₹2,200","theme":"primary","page":{"documentId":"page_contact","title":"Register & Contact","slug":"contact","createdAt":"2026-01-14T10:00:00.000Z","updatedAt":"2026-01-14T10:00:00.000Z","publishedAt":"2026-01-14T10:00:00.000Z"},"externalPage":null,"modal":false},"blocks":[{"id":"598","title":"Avani Lekhara (SH1 Rifle)\nFirst Indian woman to win back-to-back Paralympic Golds (Tokyo 2020 & Paris 2024, 10m Air Rifle Standing SH1 · Paralympic Record 249.7)"},{"id":"599","title":"Sumit Antil (F64 Javelin)\nDouble Paralympic Gold Medallist (Tokyo 2020 & Paris 2024) & World Record holder (73.29m) with a 70.59m Paralympic Record in Paris"},{"id":"600","title":"Devendra Jhajharia (F46 Javelin)\nPadma Bhushan & 3-Time Paralympic Medallist (Athens 2004 Gold, Rio 2016 Gold, Tokyo 2020 Silver) · President, Paralympic Committee of India"},{"id":"601","title":"Sheetal Devi (Open Compound Archery)\nWorld’s first armless female international para-archery champion · Paris 2024 Paralympic Bronze & Asian Para Games Double Gold"},{"id":"602","title":"Dr. Deepa Malik (F53 Shot Put)\nFirst Indian woman Paralympic medallist (Rio 2016 Silver) · Padma Shri & Khel Ratna · Trailblazer of India’s Purple Sports movement"},{"id":"603","title":"Bhavina Patel, Mariyappan Thangavelu & Praveen Kumar\nGujarat’s pride Bhavina Patel (Class 4 Table Tennis Silver) alongside High Jump legends Mariyappan Thangavelu (T42/T63) & Praveen Kumar (T64 Gold)"}]}}]]
