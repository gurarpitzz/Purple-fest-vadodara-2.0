6:["$","html",null,{"lang":"en","className":"is-loading __variable_3c02a0","children":[["$","head",null,{"children":[["$","link",null,{"rel":"icon","type":"image/png","href":"/web-app-manifest-192x192.png","sizes":"192x192"}],["$","link",null,{"rel":"icon","type":"image/svg+xml","href":"/favicon.svg"}],["$","link",null,{"rel":"apple-touch-icon","sizes":"512x512","href":"/apple-touch-icon.png"}],["$","link",null,{"rel":"manifest","href":"/site.webmanifest"}],["$","meta",null,{"name":"viewport","content":"width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover"}],false]}],["$","body",null,{"suppressHydrationWarning":true,"children":[["$","a","skip-to-content",{"href":"#main-content","className":"skip-to-content","children":"Skip to main content"}],["$","$La",null,{"CEOMessageData":{"documentId":"pf_ceo_msg_2027","firstName":"Dr. Satendra Singh","lastName":"& Satish Kapoor","position":"Organising Committee · Praangan & We Are Together (Brotherhood)","content":"<p>To All Delegates, Innovators, Educators & Champions,</p><p>When the International Purple Fest first convened in Goa, it transformed how India experiences disability—moving from charity and welfare to human rights, celebration, accessibility, and pride across all <strong>21 Benchmark Disabilities under the RPwD Act 2016</strong>.</p><p>On <strong>14–16 January 2027</strong>, hosted by <strong>Praangan (Vadodara)</strong> and <strong>We Are Together (Brotherhood, New Delhi)</strong> in academic partnership with the <strong>Global Inclusive Education Network (GIEN)</strong> and <strong>Tata Institute of Social Sciences (TISS)</strong>, Purple Fest arrives in Vadodara—the cultural capital shaped by Maharaja Sayajirao Gaekwad III’s pioneering legacy of universal education and social reform.</p><p>Whether you join as a registered delegate (₹2,200 full 3-day pass), an assistive technology innovator, a Paralympic athlete, an educator, or a CSR partner, you are co-architecting a barrier-free India.</p><p>Nothing About Us, Without Us.</p>","createdAt":"2026-01-14T10:00:00.000Z","updatedAt":"2026-01-14T10:00:00.000Z","publishedAt":"2026-01-14T10:00:00.000Z"},"footerData":{"documentId":"pf_footer_2027","email":"purplefestvadodara@gmail.com","phone":"+91 98250 93918","copyright":"© [[year_now]] Purple Fest Vadodara.","createdAt":"2026-01-14T10:00:00.000Z","updatedAt":"2026-01-14T10:00:00.000Z","publishedAt":"2026-01-14T10:00:00.000Z","socialNetworks":[{"id":"13","link":"https://www.instagram.com/","type":"instagram"},{"id":"14","link":"https://www.linkedin.com/","type":"linkedin"},{"id":"15","link":"https://www.facebook.com/","type":"facebook"},{"id":"16","link":"https://x.com/","type":"x"}],"logos":{"id":"8","title":"Organising Coalition & Institutional Partners:","images":[{"documentId":"pf_pf_partner_praangan_","name":"pf_partner_praangan.png","alternativeText":"Praangan Vadodara","caption":"Praangan Vadodara","width":212,"height":92,"formats":{"thumbnail":{"name":"thumb_pf_partner_praangan.png","hash":"thumb_pf_partner_praangan.png","ext":".png","mime":"image/png","path":null,"width":245,"height":138,"size":12.5,"sizeInBytes":12500,"url":"/uploads/pf_partner_praangan.png"},"small":{"name":"small_pf_partner_praangan.png","hash":"small_pf_partner_praangan.png","ext":".png","mime":"image/png","path":null,"width":750,"height":422,"size":64,"sizeInBytes":64000,"url":"/uploads/pf_partner_praangan.png"}},"hash":"pf_partner_praangan","ext":".png","mime":"image/png","size":450,"url":"/uploads/pf_partner_praangan.png","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2026-01-14T10:00:00.000Z","updatedAt":"2026-01-14T10:00:00.000Z","publishedAt":"2026-01-14T10:00:00.000Z"},{"documentId":"pf_pf_partner_brotherho","name":"pf_partner_brotherhood.png","alternativeText":"We Are Together (Brotherhood)","caption":"We Are Together (Brotherhood)","width":212,"height":92,"formats":{"thumbnail":{"name":"thumb_pf_partner_brotherhood.png","hash":"thumb_pf_partne