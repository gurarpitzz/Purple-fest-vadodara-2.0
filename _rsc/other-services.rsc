a:I[8204,["947","static/chunks/7fd2370d-604f7b16893c3389.js?dpl=dpl_H9boyQNzn5mWsuBVLkaVb8JjY3WH","823","static/chunks/823-5a4916a3b91045ec.js?dpl=dpl_H9boyQNzn5mWsuBVLkaVb8JjY3WH","478","static/chunks/478-1c79ca78c34c8f1a.js?dpl=dpl_H9boyQNzn5mWsuBVLkaVb8JjY3WH","528","static/chunks/528-ce74522fe7daa82e.js?dpl=dpl_H9boyQNzn5mWsuBVLkaVb8JjY3WH","376","static/chunks/376-6dea7a78410b6ad0.js?dpl=dpl_H9boyQNzn5mWsuBVLkaVb8JjY3WH","340","static/chunks/340-816a9923a87d460c.js?dpl=dpl_H9boyQNzn5mWsuBVLkaVb8JjY3WH","751","static/chunks/751-4ba22589dbd220d5.js?dpl=dpl_H9boyQNzn5mWsuBVLkaVb8JjY3WH","317","static/chunks/317-ed7330059b349994.js?dpl=dpl_H9boyQNzn5mWsuBVLkaVb8JjY3WH","42","static/chunks/app/%5Bslug%5D/page-4d4f4bb6e21ffe82.js?dpl=dpl_H9boyQNzn5mWsuBVLkaVb8JjY3WH"],"CTASection"]
2:[["$","$L9","0",{"data":{"__typename":"ComponentSectionsOtherService","id":"7","title":"All 21 Benchmark Disabilities (RPwD Act 2016) & Barrier-Free Services","description":"Purple Fest Vadodara 2027 is engineered around every single one of the 21 Benchmark Disabilities scheduled in India’s Rights of Persons with Disabilities (RPwD) Act 2016, backed by 8 mandatory on-ground accessibility services.","button":{"id":"1371","title":"Request RPwD Accommodations","theme":"primary","page":{"documentId":"page_contact","title":"Register & Contact","slug":"contact","createdAt":"2026-01-14T10:00:00.000Z","updatedAt":"2026-01-14T10:00:00.000Z","publishedAt":"2026-01-14T10:00:00.000Z"},"externalPage":null,"modal":false},"programs":[{"documentId":"pf_rpwd_cluster_1","title":"Cluster I · Visual & Hearing Sensory Disabilities (#1–#4)","requirements":[],"variants":[],"value":null,"subtitle":null,"description":"Tactile paving, Grade-1 English/Gujarati Braille directories, audio description FM loops, and spotlighted Indian Sign Language (ISL) interpretation across every stage.","reverseLabels":false,"widgetTitle":null,"requirementsList":[],"features":[{"id":"1139","title":"01. Blindness & 02. Low-Vision","description":"Continuous blister/corduroy tactile tiles, 3D tactile venue maps, refreshable Braille demos, and trained sighted-guide volunteers."},{"id":"1140","title":"03. Leprosy Cured Persons","description":"Ergonomic seating, zero-pressure grip aids, stigma-free clinical & livelihood advocacy pavilions, and assistive footwear showcases."},{"id":"1141","title":"04. Hearing Impairment (Deaf & Hard of Hearing)","description":"Certified Indian Sign Language (ISL) interpreters on all stages, live LED speech-to-text open captioning, and induction hearing loops."}],"createdAt":"2026-01-14T10:00:00.000Z","updatedAt":"2026-01-14T10:00:00.000Z","publishedAt":"2026-01-14T10:00:00.000Z"},{"documentId":"pf_rpwd_cluster_2","title":"Cluster II · Locomotor, Neuromuscular & Physical Disabilities (#5, #6, #10, #11, #20)","requirements":[],"variants":[],"value":null,"subtitle":null,"description":"IS 4963 1:12 gradient ramps, 1500 mm wheelchair turning circles, lowered 760 mm registration counters, and electric mobility buggies.","reverseLabels":false,"widgetTitle":null,"requirementsList":[],"features":[{"id":"1142","title":"05. Locomotor Disability & 06. Dwarfism","description":"Step-free stages with 1:12 ramps, dual-height handrails (700 mm & 900 mm), and lowered 760 mm exhibition/dining counters."},{"id":"1143","title":"10. Cerebral Palsy & 11. Muscular Dystrophy","description":"Power-wheelchair charging bays, hoist-equipped accessible washrooms, wide 1800 mm expo aisles, and adaptive seating."},{"id":"1144","title":"20. Acid Attack Victims","description":"Dignity-first livelihood, legal-aid, reconstructive healthcare, and entrepreneurship leadership panels."}],"createdAt":"2026-01-14T10:00:00.000Z","updatedAt":"2026-01-14T10:00:00.000Z","publishedAt":"2026-01-14T10:00:00.000Z"},{"documentId":"pf_rpwd_cluster_3","title":"Cluster III · Intellectual, Developmental, Learning & Speech (#7, #8, #9, #13, #15)","requirements":[],"variants":[],"value":null,"subtitle":null,"description":"Easy-Read visual schedules, Zone 05 Sensory Sanctuary (<45 dB), AAC communication boards, and UDL pedagogy labs.","reverseLabels":false,"widgetTitle":null,"requirementsList":[],"features":[{"id":"1145","title":"07. Intellectual Disability & 09. Autism Spectrum Disorder","description":"Zone 05 Sensory Sanctuary decompression pods, quiet entry lanes, visual storyboards, and neuro-affirming facilitators."},{"id":"1146","title":"08. Mental Illness & Psychosocial Disability","description":"Peer-support lounges, non-coercive wellness spaces, and community mental health rights dialogues with TISS faculty."},{"id":"1147","title":"13. Specific Learning Disabilities (SLD) & 15. Speech/Language","description":"Dyslexia-friendly typography, multimodal UDL toolkits, and Augmentative & Alternative Communication (AAC) tablet stations."}],"createdAt":"2026-01-14T10:00:00.000Z","updatedAt":"2026-01-14T10:00:00.000Z","publishedAt":"2026-01-14T10:00:00.000Z"},{"documentId":"pf_rpwd_cluster_4","title":"Cluster IV · Neurological, Blood Disorders & Multiple Disabilities (#12, #14, #16–#19, #21)","requirements":[],"variants":[],"value":null,"subtitle":null,"description":"Climate-controlled medical rest bays, cold-chain factor storage, tactile sign interpreters for Deafblindness, and fatigue-free shuttle loops.","reverseLabels":false,"widgetTitle":null,"requirementsList":[],"features":[{"id":"1148","title":"12. Chronic Neurological, 14. Multiple Sclerosis & 21. Parkinson’s Disease","description":"Frequent shaded rest seating every 30 meters, climate-controlled lounges, tremor-stabilizing dining aids, and priority buggy transit."},{"id":"1149","title":"16. Thalassemia, 17. Hemophilia & 18. Sickle Cell Disease","description":"On-site medical emergency bay with clotting-factor cold storage, hydration stations, and SSG Hospital / Baroda Medical College rapid link."},{"id":"1150","title":"19. Multiple Disabilities including Deafblindness","description":"Dedicated 1:1 pro-tactile sign language interpreters, Haptic/Braille schedules, and priority companion credentialing."}],"createdAt":"2026-01-14T10:00:00.000Z","updatedAt":"2026-01-14T10:00:00.000Z","publishedAt":"2026-01-14T10:00:00.000Z"}],"media":{"documentId":"pf_21disabliltes_png","name":"21disabliltes.png","alternativeText":"Blind Students Reading Tactile Braille — All 21 Benchmark Disabilities under the RPwD Act 2016","caption":"Blind Students Reading Tactile Braille — All 21 Benchmark Disabilities under the RPwD Act 2016","width":1920,"height":1080,"formats":{"thumbnail":{"name":"thumb_21disabliltes.png","hash":"thumb_21disabliltes.png","ext":".png","mime":"image/png","path":null,"width":245,"height":138,"size":12.5,"sizeInBytes":12500,"url":"/uploads/21disabliltes.png"},"small":{"name":"small_21disabliltes.png","hash":"small_21disabliltes.png","ext":".png","mime":"image/png","path":null,"width":750,"height":422,"size":64,"sizeInBytes":64000,"url":"/uploads/21disabliltes.png"}},"hash":"21disabliltes","ext":".png","mime":"image/png","size":450,"url":"/uploads/21disabliltes.png","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2026-01-14T10:00:00.000Z","updatedAt":"2026-01-14T10:00:00.000Z","publishedAt":"2026-01-14T10:00:00.000Z"},"mediaMobile":{"documentId":"pf_21disabliltes_png","name":"21disabliltes.png","alternativeText":"Blind Students Reading Tactile Braille — All 21 Benchmark Disabilities under the RPwD Act 2016","caption":"Blind Students Reading Tactile Braille — All 21 Benchmark Disabilities under the RPwD Act 2016","width":1920,"height":1080,"formats":{"thumbnail":{"name":"thumb_21disabliltes.png","hash":"thumb_21disabliltes.png","ext":".png","mime":"image/png","path":null,"width":245,"height":138,"size":12.5,"sizeInBytes":12500,"url":"/uploads/21disabliltes.png"},"small":{"name":"small_21disabliltes.png","hash":"small_21disabliltes.png","ext":".png","mime":"image/png","path":null,"width":750,"height":422,"size":64,"sizeInBytes":64000,"url":"/uploads/21disabliltes.png"}},"hash":"21disabliltes","ext":".png","mime":"image/png","size":450,"url":"/uploads/21disabliltes.png","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2026-01-14T10:00:00.000Z","updatedAt":"2026-01-14T10:00:00.000Z","publishedAt":"2026-01-14T10:00:00.000Z"}}}],["$","$La","1",{"data":{"__typename":"ComponentSectionsCta","id":"243","title":"Need Specific RPwD Accommodations in Vadodara?","description":"Declare your accessibility requirements when registering for your ₹2,200 Delegate Pass or contact our Accessibility Desk directly.","buttons":[{"id":"1372","title":"Contact Accessibility Desk","theme":"primary","page":{"documentId":"page_contact","title":"Register & Contact","slug":"contact","createdAt":"2026-01-14T10:00:00.000Z","updatedAt":"2026-01-14T10:00:00.000Z","publishedAt":"2026-01-14T10:00:00.000Z"},"externalPage":null,"modal":false}],"sequence":{"id":"360","picker":"leaves"}}}]]
