2:[["$","$L9","0",{"data":{"__typename":"ComponentSectionsIntroDefault","id":"115","title":"From Goa’s Global Mandate to Sanskari Nagari Vadodara","description":"Purple Fest Vadodara 2027 (21–23 January 2027) unites Organisers Praangan (Vadodara, Gujarat), Brotherhood (Delhi), and Centre for Disabilities Studies and Action, School of Social Work, Tata Institute of Social Sciences (TISS, Mumbai), with Knowledge Partner State Commission for Persons with Disabilities, Goa and Venue Partners The Maharaja Sayajirao University, Vadodara & GMERS Medical College, Gotri, Vadodara.","button":{"id":"1361","title":"Apply Now","theme":null,"page":null,"externalPage":"/apply","modal":false},"sequence":{"id":"345","picker":"stacked_building"}}}],["$","$La","1",{"data":{"__typename":"ComponentSectionsHomeSteps","id":"172","title":"Our Four Foundational Pillars","description":null,"whiteTheme":false,"homeStepsBlocks":[{"id":"558","label":null,"title":"Nothing About Us, Without Us","description":"Persons with disabilities across all 21 RPwD categories lead every curatorial committee, plenary panel, cultural stage, and accessibility audit."},{"id":"559","label":null,"title":"Sayajirao Gaekwad III’s Reform Heritage","description":"Rooted in Vadodara’s 130-year legacy of pioneering compulsory universal education (1893), inclusive libraries, and progressive social justice."},{"id":"560","label":null,"title":"Universal Design by Default","description":"Accessibility is never an afterthought—every physical ramp, Braille directory, ISL interpreter, and sensory pod is engineered before day one."},{"id":"561","label":null,"title":"Coalition-Driven Policy Impact","description":"Connecting grassroots DPOs with TISS, GIEN, DEPwD, and CSR leaders to translate festival dialogues into measurable education and livelihood outcomes."}],"button":null}}],["$","$Lb","2",{"data":{"__typename":"ComponentSectionsDefaultMessage","id":"163","links":[{"id":"13619","title":"Explore Viksit Bharat @ 2047 Vision","theme":"link","page":{"documentId":"page_viksit_bharat","title":"Viksit Bharat @ 2047","slug":"viksit-bharat","createdAt":"2026-01-14T10:00:00.000Z","updatedAt":"2026-01-14T10:00:00.000Z","publishedAt":"2026-01-14T10:00:00.000Z"},"externalPage":null,"modal":false}],"message":"What began in Panaji, Goa as India’s first international celebration of persons with disabilities now expands to Western India’s cultural & academic hub—bringing 10,000+ delegates, 21 RPwD categories, and 6 Experience Zones to Vadodara on 21–23 January 2027 in alignment with Hon’ble PM Shri Narendra Modi’s vision of Viksit Bharat @ 2047.","lightTheme":false}}],["$","$Lc","3",{"data":{"__typename":"ComponentSectionsTimeline","id":"38","timelineBlocks":[{"id":"562","label":"1893 · Vadodara","title":"Maharaja Sayajirao Gaekwad III’s Universal Education Mandate","description":"Baroda State becomes the first territory in India to introduce free and compulsory primary education and public library networks accessible to every citizen—laying the philosophical bedrock of Sanskari Nagari."},{"id":"563","label":"2016 · Parliament of India","title":"Enactment of the RPwD Act 2016 (21 Benchmark Disabilities)","description":"India expands statutory recognition from 7 to 21 Benchmark Disabilities—aligning domestic law with the UNCRPD mandate of non-discrimination, inclusive education (Section 16), and barrier-free infrastructure."},{"id":"564","label":"2023 · Panaji, Goa","title":"Inaugural Purple Fest Goa Ignites a National Movement","description":"The State Commission for Persons with Disabilities, Goa, together with Brotherhood (Delhi) and DEPwD, launches India’s first large-scale celebration of disability pride, sport, and culture."},{"id":"565","label":"2024 · International Purple Fest Goa","title":"Global Convergence of Assistive Tech, Paralympic Sport & GIEN","description":"Over 12,000 delegates from across India and the world gather in Goa for the International Purple Fest—establishing the gold standard for barrier-free public festivals and inclusive education summits."},{"id":"566","label":"2025–2026 · Vadodara Coalition","title":"Praangan, Brotherhood & TISS Mumbai Forge the Vadodara Charter","description":"Praangan (Vadodara, Gujarat), Brotherhood (Delhi), and the Centre for Disabilities Studies and Action, School of Social Work, Tata Institute of Social Sciences (TISS, Mumbai) unite with Knowledge Partner State Commission for Persons with Disabilities, Goa and Venue Partners MSU Vadodara & GMERS Medical College Gotri."},{"id":"567","label":"21–23 Jan 2027 · Vadodara","title":"Purple Fest Vadodara 2027: Celebrating Inclusion, Dignity & Accessibility","description":"Three historic days across 6 Experience Zones in Vadodara (21–23 January 2027)—featuring 100+ assistive tech & DPO stalls (Tiers A–D), Indian Paralympic Champions, GIEN & TISS plenaries, and Purple Kaleidoscope."}]}}],["$","$Ld","4",{"data":{"__typename":"ComponentSectionsTeam","id":"38","title":"Organising Committee & Institutional Coalition","description":"Official Organising Committee, Advisors, Knowledge Partner, and Venue Partners of Purple Fest Vadodara 2027 (21–23 January 2027).","media":{"documentId":"pf_indian_pwd_group_tra","name":"indian_pwd_group_transparent.png","alternativeText":"Indian Persons with Disabilities — Purple Fest Vadodara 2027","caption":"Indian Persons with Disabilities — Purple Fest Vadodara 2027","width":2380,"height":886,"formats":{"thumbnail":{"name":"thumb_indian_pwd_group_transparent.png","hash":"thumb_indian_pwd_group_transparent.png","ext":".png","mime":"image/png","path":null,"width":245,"height":138,"size":12.5,"sizeInBytes":12500,"url":"/uploads/indian_pwd_group_transparent.png"},"small":{"name":"small_indian_pwd_group_transparent.png","hash":"small_indian_pwd_group_transparent.png","ext":".png","mime":"image/png","path":null,"width":750,"height":422,"size":64,"sizeInBytes":64000,"url":"/uploads/indian_pwd_group_transparent.png"}},"hash":"indian_pwd_group_tra