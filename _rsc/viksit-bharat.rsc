2:[["$","$L9","0",{"data":{"__typename":"ComponentSectionsIntroDefault","id":"115","title":"Viksit Bharat @ 2047: Divyangjan at the Heart of Developed India","description":"Inspired by Hon’ble Prime Minister Shri Narendra Modi’s national vision of Viksit Bharat @ 2047 and Sugamya Bharat Abhiyan—transforming India from welfare to human dignity, assistive deep-tech, and Paralympic excellence across all 21 Benchmark Disabilities.","button":{"id":"13610","title":"Apply Now","theme":null,"page":null,"externalPage":"/apply","modal":false},"sequence":{"id":"345","picker":"stacked_building"}}}],["$","$La","1",{"data":{"__typename":"ComponentSectionsHomeSteps","id":"172","title":"Four Foundational Aims of Viksit Bharat @ 2047","description":null,"whiteTheme":false,"homeStepsBlocks":[{"id":"1558","label":"01","title":"Sugamya Bharat Abhiyan (100% Barrier-Free India)","description":"Universal accessibility across built infrastructure, public transport (Amrit Bharat Stations & accessible airports), and digital public infrastructure (WCAG 2.1 AA+ & IS 4963)."},{"id":"1559","label":"02","title":"From Viklang to Divyangjan: Constitutional Dignity (RPwD Act 2016)","description":"Hon’ble PM Shri Narendra Modi’s historic shift recognizing Divyangjan (Persons with Divine Ability) and expanding statutory rights from 7 to 21 Benchmark Disabilities."},{"id":"1560","label":"03","title":"Atmanirbhar Assistive Tech & Inclusive Education (NEP 2020)","description":"Indigenous manufacturing of AI screen readers, bionic prosthetics, and ALIMCO assistive devices paired with NEP 2020 Universal Design for Learning (GIEN & TISS Conclave)."},{"id":"1561","label":"04","title":"Target Paralympic Podium & Global Sporting Superpower","description":"Empowering India’s Paralympic Champions from Tokyo & Paris to the 2036 India Olympic & Paralympic vision in Gujarat."}],"button":null}}],["$","$Lb","2",{"data":{"__typename":"ComponentSectionsDefaultMessage","id":"163","links":[{"id":"13611","title":"Explore All 21 RPwD Disabilities","theme":"link","page":{"documentId":"page_other_services","title":"21 RPwD Disabilities","slug":"other-services","createdAt":"2026-01-14T10:00:00.000Z","updatedAt":"2026-01-14T10:00:00.000Z","publishedAt":"2026-01-14T10:00:00.000Z"},"externalPage":null,"modal":false}],"message":"“Sabka Saath, Sabka Vikas, Sabka Vishwas, Sabka Prayas”—under Hon’ble Prime Minister Shri Narendra Modi’s leadership, Divyangjan Sashaktikaran stands at the core of Viksit Bharat @ 2047, uniting Sugamya Bharat Abhiyan, the RPwD Act 2016 (21 Benchmark Disabilities), and Purple Fest Vadodara 2027 (21–23 January 2027).","lightTheme":false}}],["$","$Lc","3",{"data":{"__typename":"ComponentSectionsTimeline","id":"38","timelineBlocks":[{"id":"1562","label":"2014 · Vadodara & New Delhi","title":"Shri Narendra Modi Elected from Vadodara; Coins “Divyangjan”","description":"Shri Narendra Modi is elected to the 16th Lok Sabha from Vadodara & Varanasi and coins “Divyangjan” (Persons with Divine Ability) to transform national mindset from sympathy to constitutional respect."},{"id":"1563","label":"2015 · Sugamya Bharat Abhiyan","title":"Launch of the Accessible India Campaign","description":"Launch of the Accessible India Campaign (Sugamya Bharat Abhiyan) for barrier-free buildings, public transport corridors, and accessible digital ecosystems."},{"id":"1564","label":"2016 · RPwD Act 2016","title":"Parliament Enacts Rights of Persons with Disabilities Act (21 Disabilities)","description":"Parliament enacts the Rights of Persons with Disabilities Act covering 21 Benchmark Disabilities, expanding reservations in higher education (5%) and government jobs (4%)."},{"id":"1565","label":"2020 · NEP 2020 Inclusive Pedagogy","title":"National Education Policy Mandates Barrier-Free Learning","description":"National Education Policy 2020 mandates barrier-free, equitable education, Indian Sign Language (ISL) standardization, and Universal Design for Learning from foundational to higher learning."},{"id":"1566","label":"2024 · Historic Paris Paralympics & International Purple Fest","title":"PM Modi Felicitates India’s Record-Breaking 29-Medal Paralympic Contingent","description":"Hon’ble PM Shri Narendra Modi felicitates India’s record-breaking 29-medal Paris 2024 Paralympic contingent and champions the International Purple Fest movement."},{"id":"1567","label":"2027 → 2047 · Purple Fest Vadodara to Viksit Bharat @ 100","title":"Sanskari Nagari Vadodara Hosts Purple Fest (21–23 Jan 2027) Toward 2047","description":"Sanskari Nagari Vadodara hosts Purple Fest (21–23 Jan 2027) across 6 Barrier-Free Experience Zones as a flagship national milestone toward a 100% inclusive Developed India by 2047."}]}}],["$","$Ld","4",{"data":{"__typename":"ComponentSectionsTeam","id":"38","title":"Hon’ble PM Shri Narendra Modi & Viksit Bharat @ 2047 Visual Showcase","description":"Official visual chronicle of Hon’ble Prime Minister Shri Narendra Modi’s national missions for Divyangjan Sashaktikaran, Sugamya Bharat Abhiyan, assistive technology self-reliance, and Paralympic glory.","media":{"documentId":"pf_viksit_bharat_2047_b","name":"viksit_bharat_2047_banner.jpg","alternativeText":"Hon’ble Prime Minister Shri Narendra Modi with Indian Paralympic Contingent — Viksit Bharat @ 2047","caption":"Hon’ble Prime Minister Shri Narendra Modi with Indian Paralympic Contingent — Viksit Bharat @ 2047","width":2000,"height":1266,"formats":{"thumbnail":{"name":"thumb_viksit_bharat_2047_banner.jpg","hash":"thumb_viksit_bharat_2047_banner.jpg","ext":".jpg","mime":"image/jpeg","path":null,"width":245,"height":138,"size":12.5,"sizeInBytes":12500,"url":"/uploads/viksit_bharat_2047_banner.jpg"},"small":{"name":"small_viksit_bharat_2047_banner.jpg","hash":"small_viksit_bharat_2047_banner.jpg","ext":".jpg","mime":"image/jpeg","path":null,"width":750,"height":422,"size":64,"sizeInBytes":64000,"url":"/uploads/viksit_bharat_2047_banner.jpg"}},"hash":"viksit_bharat_2047_banner","ext":".jpg","mime