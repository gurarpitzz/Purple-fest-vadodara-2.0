2:[["$","$L9","0",{"data":{"__typename":"ComponentSectionsIntroDefault","id":"112","title":"Co-Create Purple Fest Vadodara 2027","description":"Join our 500+ Inclusive Volunteer Brigade, perform on the Purple Kaleidoscope stage, interpret in Indian Sign Language (ISL), or present research at the GIEN & TISS Conclave.","button":{"id":"1363","title":"View Open Roles & Calls","theme":null,"page":null,"externalPage":"#open-positions","modal":false},"sequence":{"id":"329","picker":"careers"}}}],["$","$La","1",{"data":{"__typename":"ComponentSectionsDefaultMessage","id":"160","links":[],"message":"Purple Fest Vadodara 2027 is built by disabled leaders, university students, special educators, ISL interpreters, therapists, and civic volunteers working shoulder-to-shoulder in Sanskari Nagari.","lightTheme":false}}],["$","$Lb","2",{"data":{"__typename":"ComponentSectionsStickyBlocksWIthContentImage","id":"27","stickyBlocks":[{"id":"586","title":"What we do","description":"<p>We convene <strong>10,000+ delegates, 100+ assistive technology &amp; DPO exhibitors, Paralympic champions, and global educators</strong> across 6 barrier-free Experience Zones in Vadodara on <strong>21–23 January 2027</strong>.</p>","media":{"documentId":"pf_pf_doc_miracle_on_wh","name":"pf_doc_miracle_on_wheels_india.jpg","alternativeText":"Indian Classical Wheelchair & Crutches Stage Dance — Miracle on Wheels at Purple Fest","caption":"Indian Classical Wheelchair & Crutches Stage Dance — Miracle on Wheels at Purple Fest","width":2560,"height":1440,"formats":{"thumbnail":{"name":"thumb_pf_doc_miracle_on_wheels_india.jpg","hash":"thumb_pf_doc_miracle_on_wheels_india.jpg","ext":".jpg","mime":"image/jpeg","path":null,"width":245,"height":138,"size":12.5,"sizeInBytes":12500,"url":"/uploads/pf_doc_miracle_on_wheels_india.jpg"},"small":{"name":"small_pf_doc_miracle_on_wheels_india.jpg","hash":"small_pf_doc_miracle_on_wheels_india.jpg","ext":".jpg","mime":"image/jpeg","path":null,"width":750,"height":422,"size":64,"sizeInBytes":64000,"url":"/uploads/pf_doc_miracle_on_wheels_india.jpg"}},"hash":"pf_doc_miracle_on_wheels_india","ext":".jpg","mime":"image/jpeg","size":450,"url":"/uploads/pf_doc_miracle_on_wheels_india.jpg","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2026-01-14T10:00:00.000Z","updatedAt":"2026-01-14T10:00:00.000Z","publishedAt":"2026-01-14T10:00:00.000Z"},"mediaMobile":{"documentId":"pf_pf_doc_miracle_on_wh","name":"pf_doc_miracle_on_wheels_mobile.jpg","alternativeText":"Indian Classical Wheelchair & Crutches Stage Dance — Miracle on Wheels at Purple Fest","caption":"Indian Classical Wheelchair & Crutches Stage Dance — Miracle on Wheels at Purple Fest","width":750,"height":1300,"formats":{"thumbnail":{"name":"thumb_pf_doc_miracle_on_wheels_mobile.jpg","hash":"thumb_pf_doc_miracle_on_wheels_mobile.jpg","ext":".jpg","mime":"image/jpeg","path":null,"width":245,"height":138,"size":12.5,"sizeInBytes":12500,"url":"/uploads/pf_doc_miracle_on_wheels_mobile.jpg"},"small":{"name":"small_pf_doc_miracle_on_wheels_mobile.jpg","hash":"small_pf_doc_miracle_on_wheels_mobile.jpg","ext":".jpg","mime":"image/jpeg","path":null,"width":750,"height":422,"size":64,"sizeInBytes":64000,"url":"/uploads/pf_doc_miracle_on_wheels_mobile.jpg"}},"hash":"pf_doc_miracle_on_wheels_mobile","ext":".jpg","mime":"image/jpeg","size":450,"url":"/uploads/pf_doc_miracle_on_wheels_mobile.jpg","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2026-01-14T10:00:00.000Z","updatedAt":"2026-01-14T10:00:00.000Z","publishedAt":"2026-01-14T10:00:00.000Z"}},{"id":"587","title":"What we believe","description":"<p>We believe in <strong>“Nothing About Us, Without Us.”</strong> Inclusion across all <strong>21 Benchmark Disabilities (RPwD Act 2016)</strong> is a fundamental constitutional right—celebrated through art, sport, science, and education.</p>","media":{"documentId":"pf_pf_doc_indian_paraly","name":"pf_doc_indian_paralympians.jpg","alternativeText":"Indian Paralympic Medallists Deepa Malik, Mariyappan Thangavelu & Devendra Jhajharia","caption":"Indian Paralympic Medallists Deepa Malik, Mariyappan Thangavelu & Devendra Jhajharia","width":2560,"height":1440,"formats":{"thumbnail":{"name":"thumb_pf_doc_indian_paralympians.jpg","hash":"thumb_pf_doc_indian_paralympians.jpg","ext":".jpg","mime":"image/jpeg","path":null,"width":245,"height":138,"size":12.5,"sizeInBytes":12500,"url":"/uploads/pf_doc_indian_paralympians.jpg"},"small":{"name":"small_pf_doc_indian_paralympians.jpg","hash":"small_pf_doc_indian_paralympians.jpg","ext":".jpg","mime":"image/jpeg","path":null,"width":750,"height":422,"size":64,"sizeInBytes":64000,"url":"/uploads/pf_doc_indian_paralympians.jpg"}},"hash":"pf_doc_indian_paralympians","ext":".jpg","mime":"image/jpeg","size":450,"url":"/uploads/pf_doc_indian_paralympians.jpg","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2026-01-14T10:00:00.000Z","updatedAt":"2026-01-14T10:00:00.000Z","publishedAt":"2026-01-14T10:00:00.000Z"},"mediaMobile":{"documentId":"pf_pf_doc_indian_paraly","name":"pf_doc_indian_paralympians.jpg","alternativeText":"Indian Paralympic Medallists Deepa Malik, Mariyappan Thangavelu & Devendra Jhajharia","caption":"Indian Paralympic Medallists Deepa Malik, Mariyappan Thangavelu & Devendra Jhajharia","width":2560,"height":1440,"formats":{"thumbnail":{"name":"thumb_pf_doc_indian_paralympians.jpg","hash":"thumb_pf_doc_indian_paralympians.jpg","ext":".jpg","mime":"image/jpeg","path":null,"width":245,"height":138,"size":12.5,"sizeInBytes":12500,"url":"/uploads/pf_doc_indian_paralympians.jpg"},"small":{"name":"small_pf_doc_indian_paralympians.jpg","hash":"small_pf_doc_indian_paralympians.jpg","ext":".jpg","mime":"image/jpeg","path":null,"width":750,"height":422,"size":64,"sizeInBytes":64000,"url":"/uploads/pf_doc_indian_paralympians.jpg"}},"hash":"pf_doc_indian_paralympians","ext":".jpg","mime":"image/jpeg","size":450,"url":"/uploads/pf_doc_indian_paralympians.jpg","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2026-01-14T10:00:00.000Z","updatedAt":"2026-01-14T10:00:00.000Z","publishedAt":"2026-01-14T10:00:00.000Z"}},{"id":"588","title":"How we work","description":"<p>Every volunteer and coordinator receives certified training in <strong>disability etiquette, sighted-guide technique, basic Indian Sign Language (ISL), neuro-affirming support, and emergency evacuation</strong>—earning a joint Praangan · Brotherhood · GIEN · TISS Certificate.</p>","media":{"documentId":"pf_pf_doc_isl_stage_int","name":"pf_doc_isl_stage_interpreter.jpg","alternativeText":"Spotlighted Sign Language Interpreter on Festival Stage","caption":"Spotlighted Sign Language Interpreter on Festival Stage","width":2560,"height":1440,"formats":{"thumbnail":{"name":"thumb_pf_doc_isl_stage_interpreter.jpg","hash":"thumb_pf_doc_isl_stage_interpreter.jpg","ext":".jpg","mime":"image/jpeg","path":null,"width":245,"height":138,"size":12.5,"sizeInBytes":12500,"url":"/uploads/pf_doc_isl_stage_interpreter.jpg"},"small":{"name":"small_pf_doc_isl_stage_interpreter.jpg","hash":"small_pf_doc_isl_stage_interpreter.jpg","ext":".jpg","mime":"image/jpeg","path":null,"width":750,"height":422,"size":64,"sizeInBytes":64000,"url":"/uploads/pf_doc_isl_stage_interpreter.jpg"}},"hash":"pf_doc_isl_stage_interpreter","ext":".jpg","mime":"image/jpeg","size":450,"url":"/uploads/pf_doc_isl_stage_interpreter.jpg","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2026-01-14T10:00:00.000Z","updatedAt":"2026-01-14T10:00:00.000Z","publishedAt":"2026-01-14T10:00:00.000Z"},"mediaMobile":{"documentId":"pf_pf_doc_isl_stage_int","name":"pf_doc_isl_stage_interpreter.jpg","alternativeText":"Spotlighted Sign Language Interpreter on Festival Stage","caption":"Spotlighted Sign Language Interpreter on Festival Stage","width":2560,"height":1440,"formats":{"thumbnail":{"name":"thumb_pf_doc_isl_stage_interpreter.jpg","hash":"thumb_pf_doc_isl_stage_interpreter.jpg","ext":".jpg","mime":"image/jpeg","path":null,"width":245,"height":138,"size":12.5,"sizeInBytes":12500,"url":"/uploads/pf_doc_isl_stage_interpreter.jpg"},"small":{"name":"small_pf_doc_isl_stage_interpreter.jpg","hash":"small_pf_doc_isl_stage_interpreter.jpg","ext":".jpg","mime":"image/jpeg","path":null,"width":750,"height":422,"size":64,"sizeInBytes":64000,"url":"/uploads/pf_doc_isl_stage_interpreter.jpg"}},"hash":"pf_doc_isl_stage_interpreter","ext":".jpg","mime":"image/jpeg","size":450,"url":"/uploads/pf_doc_isl_stage_interpreter.jpg","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2026-01-14T10:00:00.000Z","updatedAt":"2026-01-14T10:00:00.000Z","publishedAt":"2026-01-14T10:00:00.000Z"}}]}}],["$","section",null,{"id":"open-positions","className":"py-80 md:py-120 laptop:pt-160 2xl:pt-224 bg-cream","children":["$","div",null,{"className":"container","children":[["$","h2",null,{"className":"h1 mb-56 md:mb-80 lg:mb-120","children":["$","$Lc",null,{"animateOnScroll":"lines","children":"Open Participation & Volunteer Tracks"}]}],["$","div",null,{"className":"flex flex-col gap-y-24 md:gap-y-40","children":[["$","$Ld","0",{"children":["$","$Le",null,{"data":{"documentId":"pf_role_1","title":"Inclusive Accessibility & Sighted-Guide Volunteer Brigade","description":"Support delegates across all 21 RPwD categories at venue gates, tactile corridors, wheelchair buggy shuttles, and Zone 01–06 helpdesks (21–23 Jan 2027). Joint Praangan & Brotherhood certification provided.","position":"Volunteer Brigade (500+ Seats)","location":"Vadodara, Gujarat","link":{"id":"4","title":"Apply / Register Now","externalPage":"/contact","modal":null}}}]}],["$","$Ld","1",{"children":["$","$Le",null,{"data":{"documentId":"pf_role_2","title":"Indian Sign Language (ISL) Interpreter & Live Captioning Fellow","description":"Provide simultaneous ISL interpretation and pro-tactile Deafblind communication across keynote plenaries, GIEN & TISS academic panels, and Zone 01 assistive tech demos.","position":"Accessibility & Language Desk","location":"Vadodara, Gujarat","link":{"id":"6","title":"Apply / Register Now","externalPage":"/contact","modal":null}}}]}],["$","$Ld","2",{"children":["$","$Le",null,{"data":{"documentId":"pf_role_3","title":"Purple Kaleidoscope & Abhivyakti Performing Artist / Ensemble","description":"Open call for soloists and troupes with disabilities in classical/contemporary dance, music, Deaf theatre, stand-up comedy, adaptive fashion, and tactile visual arts.","position":"Zone 03 · Cultural Stage","location":"Vadodara, Gujarat","link":{"id":"8","title":"Submit Performance Proposal","externalPage":"/contact","modal":null}}}]}],["$","$Ld","3",{"children":["$","$Le",null,{"data":{"documentId":"pf_role_4","title":"GIEN & TISS Inclusive Education Paper / Poster Presenter","description":"Submit research abstracts, school UDL case studies, or assistive technology prototypes for the 3-day Global Inclusive Education Network (GIEN) & TISS Academic Conclave.","position":"Zone 02 · Academic Conclave","location":"Vadodara, Gujarat","link":{"id":"10","title":"Submit Abstract / Register","externalPage":"/contact","modal":null}}}]}]]}]]}]}],["$","$Lf","4",{"data":{"__typename":"ComponentSectionsCtaSecondary","id":"39","title":"Bring Your University, School or DPO Cohort to Vadodara","description":"Write to purplefestivalvadodara@gmail.com or call Radha Tandon (+91 99743 83920) / Satish Kapoor (+91 98994 72065, +91 92117 60202) to coordinate group volunteer brigades, student delegations, or cultural ensembles.","whiteTheme":true,"rowReverse":null,"button":{"id":"1364","title":"Contact Organising Secretariat","theme":"primary","page":{"documentId":"page_contact","title":"Register & Contact","slug":"contact","createdAt":"2026-01-14T10:00:00.000Z","updatedAt":"2026-01-14T10:00:00.000Z","publishedAt":"2026-01-14T10:00:00.000Z"},"externalPage":null,"modal":false},"media":{"documentId":"pf_pf_doc_student_wheel","name":"pf_do