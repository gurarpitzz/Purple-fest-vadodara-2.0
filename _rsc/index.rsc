link","page":null,"externalPage":"https://www.google.com/maps/search/?api=1&query=Praangan+Education+Trust,+1st+Floor,+Trimurti+Apartments,+Baroda+Imaging+Lab+Lane,+Near+Mahalakshmi+Store,+Alkapuri,+Vadodara,+Gujarat","modal":false}],"message":"Join Us — Praangan Education Trust, 1st Floor, Trimurti Apartments, Baroda Imaging Lab Lane, Near Mahalakshmi Store, Alkapuri, Vadodara, Gujarat","lightTheme":true}}],["$","$L8","2",{"data":{"__typename":"ComponentSectionsHomeBenefits","id":"137","title":"Why Purple Fest Vadodara 2027","mediaMobile":{"documentId":"pf_indian_pwd_group_tra","name":"indian_pwd_group_transparent.png","alternativeText":"Indian Persons with Disabilities — Purple Fest Vadodara 2027","caption":"Indian Persons with Disabilities — Purple Fest Vadodara 2027","width":2380,"height":886,"formats":{"thumbnail":{"name":"thumb_indian_pwd_group_transparent.png","hash":"thumb_indian_pwd_group_transparent.png","ext":".png","mime":"image/png","path":null,"width":245,"height":138,"size":12.5,"sizeInBytes":12500,"url":"/uploads/indian_pwd_group_transparent.png"},"small":{"name":"small_indian_pwd_group_transparent.png","hash":"small_indian_pwd_group_transparent.png","ext":".png","mime":"image/png","path":null,"width":750,"height":422,"size":64,"sizeInBytes":64000,"url":"/uploads/indian_pwd_group_transparent.png"}},"hash":"indian_pwd_group_transparent","ext":".png","mime":"image/png","size":450,"url":"/uploads/indian_pwd_group_transparent.png","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2026-01-14T10:00:00.000Z","updatedAt":"2026-01-14T10:00:00.000Z","publishedAt":"2026-01-14T10:00:00.000Z"},"blocks":[{"id":"532","title":"All 21 RPwD Disabilities","description":"Designed from the ground up around all 21 Benchmark Disabilities recognized by India’s Rights of Persons with Disabilities (RPwD) Act 2016—with zero charity framing and 100% human rights dignity."},{"id":"533","title":"Goa Legacy Meets Sanskari Nagari","description":"Bridging the historic International Purple Fest Goa movement with Maharaja Sayajirao Gaekwad III’s 1893 universal education mandate in Vadodara."},{"id":"534","title":"GIEN & TISS Academic Rigor","description":"Co-curated with the Global Inclusive Education Network (GIEN) and Tata Institute of Social Sciences (TISS) to turn Universal Design for Learning (UDL) into policy action."},{"id":"535","title":"100% Barrier-Free Architecture","description":"Every stage, stall, washroom, and digital touchpoint enforces IS 4963 1:12 ramps, continuous tactile paving, Indian Sign Language (ISL), Braille directories, and Sensory Sanctuaries."}],"media":{"documentId":"pf_indian_pwd_group_tra","name":"indian_pwd_group_transparent.png","alternativeText":"Indian Persons with Disabilities — Purple Fest Vadodara 2027","caption":"Indian Persons with Disabilities — Purple Fest Vadodara 2027","width":2380,"height":886,"formats":{"thumbnail":{"name":"thumb_indian_pwd_group_transparent.png","hash":"thumb_indian_pwd_group_transparent.png","ext":".png","mime":"image/png","path":null,"width":245,"height":138,"size":12.5,"sizeInBytes":12500,"url":"/uploads/indian_pwd_group_transparent.png"},"small":{"name":"small_indian_pwd_group_transparent.png","hash":"small_indian_pwd_group_transparent.png","ext":".png","mime":"image/png","path":null,"width":750,"height":422,"size":64,"sizeInBytes":64000,"url":"/uploads/indian_pwd_group_transparent.png"}},"hash":"indian_pwd_group_transparent","ext":".png","mime":"image/png","size":450,"url":"/uploads/indian_pwd_group_transparent.png","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2026-01-14T10:00:00.000Z","updatedAt":"2026-01-14T10:00:00.000Z","publishedAt":"2026-01-14T10:00:00.000Z"}}}],["$","$L9","3",{"data":{"__typename":"ComponentSectionsHomeMetrics","id":"137","title":"A National Convergence of Inclusion in Vadodara","blocks":[{"id":"536","title":"10,000+","description":"Registered Delegates, Educators, Innovators & Leaders across 3 Days (21–23 January 2027)"},{"id":"537","title":"21","description":"Benchmark Disabilities under the RPwD Act 2016 represented with full accessibility"},{"id":"538","title":"6 Zones","description":"Immersive Barrier-Free Experience Zones spanning Tech, Education, Arts, Sports & Nature"},{"id":"539","title":"100+","description":"Assistive Technology Exhibitors, DPO Collectives, Universities & CSR Pavilions"}]}}],["$","$La","4",{"data":{"__typename":"ComponentSectionsHomePrograms","id":"134","homeProgramsBlocks":[{"documentId":"pf_hp_1","title":"Zone 01 · Assistive Tech & Startup Expo","requirements":[{"id":"210","title":"AI Screen Readers & Refreshable Braille"},{"id":"211","title":"Bionic Prosthetics & All-Terrain Wheelchairs"},{"id":"212","title":"AAC Speech Devices & Smart Cane Radar"}],"variants":[],"value":"Tier A–D Stalls","subtitle":"Starting at","description":"Hands-on assistive technology showcase featuring 100+ startups, ALIMCO, IIT R&D labs, and grassroots DPOs. Stalls available in Tier D (₹5,500), Tier C (₹12,000), Tier A (₹15,000), and Tier B (₹35,000).","reverseLabels":true,"widgetTitle":"Assistive Tech Expo","createdAt":"2026-01-14T10:00:00.000Z","updatedAt":"2026-01-14T10:00:00.000Z","publishedAt":"2026-01-14T10:00:00.000Z","media":{"documentId":"pf_purple_expo_jpg","name":"purple_expo.jpg","alternativeText":"Assistive Technology & Bionic Prosthetics Expo","caption":"Assistive Technology & Bionic Prosthetics Expo","width":2560,"height":1440,"formats":{"thumbnail":{"name":"thumb_purple_expo.jpg","hash":"thumb_purple_expo.jpg","ext":".jpg","mime":"image/jpeg","path":null,"width":245,"height":138,"size":12.5,"sizeInBytes":12500,"url":"/uploads/purple_expo.jpg"},"small":{"name":"small_purple_expo.jpg","hash":"small_purple_expo.jpg","ext":".jpg","mime":"image/jpeg","path":null,"width":750,"height":422,"size":64,"sizeInBytes":64000,"url":"/uploads/purple_expo.jpg"}},"hash":"purple_expo","ext":".jpg","mime":"image/jpeg","size":450,"url":"/uploads/purple_expo.jpg","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2026-01-14T10:00:00.000Z","updatedAt":"2026-01-14T10:00:00.000Z","publishedAt":"2026-01-14T10:00:00.000Z"},"mediaMobile":{"documentId":"pf_purple_expo_mobile_j","name":"purple_expo_mobile.jpg","alternativeText":"Assistive Technology & Bionic Prosthetics Expo","caption":"Assistive Technology & Bionic Prosthetics Expo","width":750,"height":1300,"formats":{"thumbnail":{"name":"thumb_purple_expo_mobile.jpg","hash":"thumb_purple_expo_mobile.jpg","ext":".jpg","mime":"image/jpeg","path":null,"width":245,"height":138,"size":12.5,"sizeInBytes":12500,"url":"/uploads/purple_expo_mobile.jpg"},"small":{"name":"small_purple_expo_mobile.jpg","hash":"small_purple_expo_mobile.jpg","ext":".jpg","mime":"image/jpeg","path":null,"width":750,"height":422,"size":64,"sizeInBytes":64000,"url":"/uploads/purple_expo_mobile.jpg"}},"hash":"purple_expo_mobile","ext":".jpg","mime":"image/jpeg","size":450,"url":"/uploads/purple_expo_mobile.jpg","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2026-01-14T10:00:00.000Z","updatedAt":"2026-01-14T10:00:00.000Z","publishedAt":"2026-01-14T10:00:00.000Z"},"button":{"id":"1396","title":"Explore All 6 Zones","theme":null,"page":{"documentId":"page_programs","title":"3-Day Programme & 6 Zones","slug":"programs","createdAt":"2026-01-14T10:00:00.000Z","updatedAt":"2026-01-14T10:00:00.000Z","publishedAt":"2026-01-14T10:00:00.000Z"},"externalPage":null,"modal":false}},{"documentId":"pf_hp_2","title":"Zone 02 · GIEN & TISS Inclusive Education Summit","requirements":[{"id":"213","title":"Universal Design for Learning (UDL) Labs"},{"id":"214","title":"NEP 2020 & RPwD Section 16 Implementation"},{"id":"215","title":"School Principal & Special Educator Roundtables"}],"variants":[],"value":"₹2,200 Pass","subtitle":"Included with","description":"International academic conclave led by Prof. Anita Julka (GIEN), Prof. Bipin Jojo (TISS Mumbai), and Dr. Satendra Singh—equipping mainstream schools and universities with barrier-free pedagogy.","reverseLabels":true,"widgetTitle":"GIEN & TISS Summit","createdAt":"2026-01-14T10:00:00.000Z","updatedAt":"2026-01-14T10:00:00.000Z","publishedAt":"2026-01-14T10:00:00.000Z","media":{"documentId":"pf_pf_doc_isl_classroom","name":"pf_doc_isl_classroom.jpg","alternativeText":"Indian Sign Language (ISL) Inclusive Classroom — GIEN & TISS Summit","caption":"Indian Sign Language (ISL) Inclusive Classroom — GIEN & TISS Summit","width":2560,"height":1440,"formats":{"thumbnail":{"name":"thumb_pf_doc_isl_classroom.jpg","hash":"thumb_pf_doc_isl_classroom.jpg","ext":".jpg","mime":"image/jpeg","path":null,"width":245,"height":138,"size":12.5,"sizeInBytes":12500,"url":"/uploads/pf_doc_isl_classroom.jpg"},"small":{"name":"small_pf_doc_isl_classroom.jpg","hash":"small_pf_doc_isl_classroom.jpg","ext":".jpg","mime":"image/jpeg","path":null,"width":750,"height":422,"size":64,"sizeInBytes":64000,"url":"/uploads/pf_doc_isl_classroom.jpg"}},"hash":"pf_doc_isl_classroom","ext":".jpg","mime":"image/jpeg","size":450,"url":"/uploads/pf_doc_isl_classroom.jpg","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2026-01-14T10:00:00.000Z","updatedAt":"2026-01-14T10:00:00.000Z","publishedAt":"2026-01-14T10:00:00.000Z"},"mediaMobile":{"documentId":"pf_pf_doc_isl_classroom","name":"pf_doc_isl_classroom.jpg","alternativeText":"Indian Sign Language (ISL) Inclusive Classroom — GIEN & TISS Summit","caption":"Indian Sign Language (ISL) Inclusive Classroom — GIEN & TISS Summit","width":2560,"height":1440,"formats":{"thumbnail":{"name":"thumb_pf_doc_isl_classroom.jpg","hash":"thumb_pf_doc_isl_classroom.jpg","ext":".jpg","mime":"image/jpeg","path":null,"width":245,"height":138,"size":12.5,"sizeInBytes":12500,"url":"/uploads/pf_doc_isl_classroom.jpg"},"small":{"name":"small_pf_doc_isl_classroom.jpg","hash":"small_pf_doc_isl_classroom.jpg","ext":".jpg","mime":"image/jpeg","path":null,"width":750,"height":422,"size"