hero.jpg","ext":".jpg","mime":"image/jpeg","path":null,"width":750,"height":422,"size":64,"sizeInBytes":64000,"url":"/uploads/purple_fest_hero.jpg"}},"hash":"purple_fest_hero","ext":".jpg","mime":"image/jpeg","size":450,"url":"/uploads/purple_fest_hero.jpg","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2026-01-14T10:00:00.000Z","updatedAt":"2026-01-14T10:00:00.000Z","publishedAt":"2026-01-14T10:00:00.000Z"},"mediaMobile":{"documentId":"pf_purple_fest_hero_mob","name":"purple_fest_hero_mobile.jpg","alternativeText":"Wheelchair Cultural Dance Performance — Purple Kaleidoscope Stage","caption":"Wheelchair Cultural Dance Performance — Purple Kaleidoscope Stage","width":750,"height":1300,"formats":{"thumbnail":{"name":"thumb_purple_fest_hero_mobile.jpg","hash":"thumb_purple_fest_hero_mobile.jpg","ext":".jpg","mime":"image/jpeg","path":null,"width":245,"height":138,"size":12.5,"sizeInBytes":12500,"url":"/uploads/purple_fest_hero_mobile.jpg"},"small":{"name":"small_purple_fest_hero_mobile.jpg","hash":"small_purple_fest_hero_mobile.jpg","ext":".jpg","mime":"image/jpeg","path":null,"width":750,"height":422,"size":64,"sizeInBytes":64000,"url":"/uploads/purple_fest_hero_mobile.jpg"}},"hash":"purple_fest_hero_mobile","ext":".jpg","mime":"image/jpeg","size":450,"url":"/uploads/purple_fest_hero_mobile.jpg","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2026-01-14T10:00:00.000Z","updatedAt":"2026-01-14T10:00:00.000Z","publishedAt":"2026-01-14T10:00:00.000Z"},"button":{"id":"1394","title":"View Cultural Schedule","theme":null,"page":{"documentId":"page_programs","title":"3-Day Programme & 6 Zones","slug":"programs","createdAt":"2026-01-14T10:00:00.000Z","updatedAt":"2026-01-14T10:00:00.000Z","publishedAt":"2026-01-14T10:00:00.000Z"},"externalPage":null,"modal":false}},{"documentId":"pf_hp_4","title":"Zone 04 · Para-Sports Arena & Champions","requirements":[{"id":"219","title":"Wheelchair Basketball, Boccia & Blind Football"},{"id":"220","title":"Sitting Volleyball, Para-Table Tennis & Para-Chess"},{"id":"221","title":"Meet Indian Paralympic Gold & Silver Medallists"}],"variants":[],"value":"8+ Champions","subtitle":"Honoring","description":"High-octane adaptive sports tournaments and athlete clinics honoring Avani Lekhara, Sumit Antil, Devendra Jhajharia, Sheetal Devi, Dr. Deepa Malik, Bhavina Patel, Mariyappan Thangavelu & Praveen Kumar.","reverseLabels":false,"widgetTitle":"Para-Sports Arena","createdAt":"2026-01-14T10:00:00.000Z","updatedAt":"2026-01-14T10:00:00.000Z","publishedAt":"2026-01-14T10:00:00.000Z","media":{"documentId":"pf_purple_sports_jpg","name":"purple_sports.jpg","alternativeText":"Paralympic Wheelchair Basketball Championship — Para-Sports Arena","caption":"Paralympic Wheelchair Basketball Championship — Para-Sports Arena","width":2560,"height":1440,"formats":{"thumbnail":{"name":"thumb_purple_sports.jpg","hash":"thumb_purple_sports.jpg","ext":".jpg","mime":"image/jpeg","path":null,"width":245,"height":138,"size":12.5,"sizeInBytes":12500,"url":"/uploads/purple_sports.jpg"},"small":{"name":"small_purple_sports.jpg","hash":"small_purple_sports.jpg","ext":".jpg","mime":"image/jpeg","path":null,"width":750,"height":422,"size":64,"sizeInBytes":64000,"url":"/uploads/purple_sports.jpg"}},"hash":"purple_sports","ext":".jpg","mime":"image/jpeg","size":450,"url":"/uploads/purple_sports.jpg","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2026-01-14T10:00:00.000Z","updatedAt":"2026-01-14T10:00:00.000Z","publishedAt":"2026-01-14T10:00:00.000Z"},"mediaMobile":{"documentId":"pf_purple_sports_mobile","name":"purple_sports_mobile.jpg","alternativeText":"Paralympic Wheelchair Basketball Championship — Para-Sports Arena","caption":"Paralympic Wheelchair Basketball Championship — Para-Sports Arena","width":750,"height":1300,"formats":{"thumbnail":{"name":"thumb_purple_sports_mobile.jpg","hash":"thumb_purple_sports_mobile.jpg","ext":".jpg","mime":"image/jpeg","path":null,"width":245,"height":138,"size":12.5,"sizeInBytes":12500,"url":"/uploads/purple_sports_mobile.jpg"},"small":{"name":"small_purple_sports_mobile.jpg","hash":"small_purple_sports_mobile.jpg","ext":".jpg","mime":"image/jpeg","path":null,"width":750,"height":422,"size":64,"sizeInBytes":64000,"url":"/uploads/purple_sports_mobile.jpg"}},"hash":"purple_sports_mobile","ext":".jpg","mime":"image/jpeg","size":450,"url":"/uploads/purple_sports_mobile.jpg","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2026-01-14T10:00:00.000Z","updatedAt":"2026-01-14T10:00:00.000Z","publishedAt":"2026-01-14T10:00:00.000Z"},"button":{"id":"1393","title":"Meet Paralympic Champions","theme":null,"page":{"documentId":"page_tier_1_program","title":"Paralympic Champions","slug":"tier-1-program","createdAt":"2026-01-14T10:00:00.000Z","updatedAt":"2026-01-14T10:00:00.000Z","publishedAt":"2026-01-14T10:00:00.000Z"},"externalPage":null,"modal":false}}]}}],["$","$Lb",null,{"data":{"__typename":"ComponentSectionsCalculatorDscr","id":"48","title":"","page":null}}],["$","$Lc","6",{"data":{"__typename":"ComponentSectionsHomeSteps","id":"173","title":"Four Steps to Join Purple Fest Vadodara 2027","description":"Every participant attends as a registered delegate or exhibitor so we can guarantee uncompromised physical, sensory, and linguistic accessibility across all 3 days.","whiteTheme":true,"homeStepsBlocks":[{"id":"546","label":"01","title":"Choose Your Track","description":"Select the Mandatory 3-Day Delegate Pass (₹2,200 per person — no free casual visitor entry) or an Exhibition Stall in Tier A (₹15,000), Tier B (₹35,000), Tier C (₹12,000), or Tier D (₹5,500)."},{"id":"547","label":"02","title":"Declare RPwD Accommodations","description":"Indicate your requirements across all 21 Benchmark Disabilities (RPwD Act 2016)—including ISL interpretation, Braille/large-print kits, wheelchair charging, tactile escort, or sensory sanctuary access."},{"id":"548","label":"03","title":"Receive QR + Braille Credential","description":"Receive your instant festival confirmation, accessible Vadodara travel & hotel guide, and QR + Grade-1 Braille embossed Delegate Credential."},{"id":"549","label":"04","title":"Converge in Vadodara (21–23 Jan 2027)","description":"Experience 3 unforgettable days of assistive innovation, GIEN & TISS dialogues, Paralympic sport, and Purple Kaleidoscope cultural nights in Sanskari Nagari."}],"button":{"id":"1355","title":"Apply Now","theme":"primary","page":null,"externalPage":"/apply","modal":false}}}],["$","$Ld","7",{"data":{"__typename":"ComponentSectionsTestimonials","id":"138","title":"Voices of the Purple Movement","testimonialBlocks":[{"id":"550","author":"Radha Tandon","title":"“Purple Fest is not about sympathy or charity; it is a declaration of human dignity, joyful celebration, and constitutional equality under the RPwD Act 2016 in Sanskari Nagari Vadodara.”","authorInfo":"Festival Director · Founder and Director of Praangan Education Trust, Vadodara"},{"id":"551","author":"Satish Kapoor","title":"“From New Delhi and Goa to Maharaja Sayajirao’s Vadodara, Brotherhood, Praangan, and TISS Mumbai are proving that true inclusion leaves none of the 21 disabilities behind.”","authorInfo":"Festival Coordinator · Founding President, Brotherhood, GIEN & We Care Film Festival, Delhi"},{"id":"552","author":"Dr. Nitin Malik & Dr. Ravinder Singh","title":"“When legal scholars, medical researchers, assistive technologists, and disabled youth sit as equals in the same pavilion, Universal Design stops being a theory and becomes lived reality.”","authorInfo":"Festival Advisors · Registrar, GNLU Gandhinagar & Director, ICMR Delhi"},{"id":"553","author":"State Commission for PwD, Goa","title":"“The International Purple Fest in Goa ignited a national flame. Serving as Knowledge Partner as Vadodara carries that torch at MSU Vadodara and GMERS Gotri is a milestone for India.”","authorInfo":"Knowledge Partner · State Commission for Persons with Disabilities, Goa"}]}}],["$","$Le","8",{"data":{"__typename":"ComponentSectionsHomeTech","id":"113","title":"From Digital QR Pass to Official Reception Desk ID Card","description":"Every registered delegate receives an instant SQL-backed QR pass upon completing the mandatory ₹2,200 registration. Present this QR code on your phone at the Purple Fest Vadodara Reception Desk to verify your pass and collect your official accredited Delegate ID Card.","homeTechDeviceFrame":null,"homeTechBlocks":[{"id":"554","title":"01 · Register & Complete Secure Razorpay Payment (₹2,200)","description":"Complete your mandatory ₹2,200 3-Day Delegate Pass registration online, declare your RPwD Act 2016 accessibility accommodations across all 21 Benchmark Disabilities, and receive instant Razorpay payment confirmation."},{"id":"555","title":"02 · Receive Your Instant SQL-Backed Digital QR Pass by Email","description":"Your confirmed Delegate ID (e.g., PFV-2027-0842) and scannable ISO QR Pass are immediately persisted in the festival SQL database, displayed on your phone screen, and dispatched to your email inbox."},{"id":"556","title":"03 · Show Your QR Code at the Event Reception Desk","description":"Upon arriving at the Praangan / MSU Reception Desk in Vadodara (21–23 January 2027), present your phone screen at the check-in scanner for sub-second optical QR verification."},{"id":"557","title":"04 · Instant Verification & Official Accredited ID Card Handover","description":"Once the reception desk terminal confirms SQL DB Match and ₹2,200 payment verification, you are immediately handed your physical Purple Fest Vadodara 2027 Official Delegate ID Card with lanyard, Grade-1 Braille embossing, and all-zone access."}],"button":{"id":"1356","title":"Register for Your QR Pass · ₹2,200","theme":"primary","page":null,"externalPage":"/apply","modal":false},"media":{"documentId":"pf_qr_checkin_idcard_fl","name":"qr_checkin_idcard_flow.mp4","alternativeText":"Purple Fest Vadodara 2027 — End-to-End QR Pass Receipt, Event Reception Desk Scan, and Official Delegate ID Card Issuance","caption":"Purple Fest Vadodara 2027 — End-to-End QR Pass Receipt, Event Reception Desk Scan, and Official Delegate ID Card Issuance","width":null,"height":null,"formats":null,"hash":"qr_checkin_idcard_flow","ext":".mp4","mime":"video/mp4","size":450,"url":"/uploads/qr_checkin_idcard_flow.mp4","previewUrl":null,"provider":"local","provider_metadata":null,"createdAt":"2026-01-14T10:00:00.000Z","updatedAt":"2026-01-14T10:00:00.000Z","publishedAt":"2026-01-14T10:00:00.000Z"}}}],["$","$Lf","9",{"data":{"__typename":"ComponentSectionsCta","id":"239","title":"Ready to Join Purple Fest Vadodara 2027?","description":"Secure your mandatory ₹2,200 3-Day Delegate Pass or book your Tier A–D Exhibition Stall for 21–23 January 2027 in Sanskari Nagari Vadodara.","buttons":[{"id":"1357","title":"Apply Now","theme":"primary","page":null,"externalPage":"/apply","modal":false}],"sequence":{"id":"355","picker":"leaves"}}}]]
