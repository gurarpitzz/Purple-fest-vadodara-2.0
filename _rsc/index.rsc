2:[["$","$L6","0",{"data":{"__typename":"ComponentSectionsHomeIntro","id":"100","title":"Inclusion, celebrated.","description":"India’s landmark festival of inclusion, human dignity, assistive technology, Paralympic sport, and universal design across all 21 Benchmark Disabilities (RPwD Act 2016).","subtitle":"Purple Fest Vadodara 2027 · 21–23 January 2027 · Sanskari Nagari Vadodara, Gujarat · Organised by Praangan (Vadodara), Brotherhood (Delhi) & TISS Mumbai · Venue Partners: MSU Vadodara & GMERS Gotri.","programs":[{"documentId":"pf_widget_pass","title":"3-Day Delegate Pass","value":"₹2,200","subtitle":"Mandatory Registration (No Free Entry)","description":"Full 3-day access to all 6 Experience Zones, GIEN & TISS Conclave, Purple Kaleidoscope & Para-Sports Arena.","reverseLabels":true,"widgetTitle":"3-Day Delegate Pass (Mandatory)","createdAt":"2026-01-14T10:00:00.000Z","updatedAt":"2026-01-14T10:00:00.000Z","publishedAt":"2026-01-14T10:00:00.000Z"},{"documentId":"pf_widget_stall","title":"Exhibition Stalls (Tiers A–D)","value":"₹5.5K–₹35K","subtitle":"Assistive Tech, CSR, Startup & DPO Pavilions","description":"Tier D DPO/NGO ₹5,500 · Tier C Startup ₹12,000 · Tier A Standard ₹15,000 · Tier B Prime Corner ₹35,000.","reverseLabels":false,"widgetTitle":"Exhibition Stalls (Tiers A–D)","createdAt":"2026-01-14T10:00:00.000Z","updatedAt":"2026-01-14T10:00:00.000Z","publishedAt":"2026-01-14T10:00:00.000Z"}],"medias":[{"documentId":"pf_indian_pwd_group_tra","name":"indian_pwd_group_transparent.png","alternativeText":"Indian Persons with Disabilities — Purple Fest Vadodara 2027","caption":"Indian Persons with Disabilities — Purple Fest Vadodara 2027","width":2380,"height":886,"formats":{"thumbnail":{"name":"thumb_indian_pwd_group_transparent.png","hash":"thumb_indian_pwd_group_transparent.png","ext":".png","mime":"image/png","path":null,"width":245,"height":138,"size":12.5,"sizeInBytes":12500,"url":"/uploads/indian_pwd_group_transparent.png"},"small":{"name":"small_indian_