a:I[2588,["947","static/chunks/7fd2370d-604f7b16893c3389.js?dpl=dpl_H9boyQNzn5mWsuBVLkaVb8JjY3WH","823","static/chunks/823-5a4916a3b91045ec.js?dpl=dpl_H9boyQNzn5mWsuBVLkaVb8JjY3WH","478","static/chunks/478-1c79ca78c34c8f1a.js?dpl=dpl_H9boyQNzn5mWsuBVLkaVb8JjY3WH","528","static/chunks/528-ce74522fe7daa82e.js?dpl=dpl_H9boyQNzn5mWsuBVLkaVb8JjY3WH","376","static/chunks/376-6dea7a78410b6ad0.js?dpl=dpl_H9boyQNzn5mWsuBVLkaVb8JjY3WH","340","static/chunks/340-816a9923a87d460c.js?dpl=dpl_H9boyQNzn5mWsuBVLkaVb8JjY3WH","751","static/chunks/751-4ba22589dbd220d5.js?dpl=dpl_H9boyQNzn5mWsuBVLkaVb8JjY3WH","317","static/chunks/317-ed7330059b349994.js?dpl=dpl_H9boyQNzn5mWsuBVLkaVb8JjY3WH","42","static/chunks/app/%5Bslug%5D/page-4d4f4bb6e21ffe82.js?dpl=dpl_H9boyQNzn5mWsuBVLkaVb8JjY3WH"],"Move"]
